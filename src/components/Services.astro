---
import ImageCard from './ImageCard.astro';
---

<section class="services section" id="services">
  <div class="container">
    <header class="services__header">
      <span class="services__label">What We Offer</span>
      <h2 class="services__title">Professional Services Tailored to Your Needs</h2>
      <p class="services__subtitle">
        From pest-free homes to pristine lawns, we provide comprehensive solutions to keep your property in top condition.
      </p>
    </header>

    <div class="services__pest-control" id="pest-control">
      <ImageCard
        image="/internal-treatment.webp"
        imageAlt="Professional pest control technician performing internal treatment with protective gear"
        icon="lucide:bug"
        title="General Pest Control"
        description="Comprehensive pest management solutions for your home and business. We eliminate and prevent infestations of all common pests."
        features={['Cockroaches & Spiders', 'Silverfish', 'Mice & Rats', 'Fleas, Ticks & Wasps']}
        ctaText="Get a Quote"
        ctaLink="/contact"
        reverse={false}
      />
    </div>

    <div class="services__lawn-care" id="lawn-care">
      <ImageCard
        image="/hedge.webp"
        imageAlt="Professional lawn care and hedge trimming services"
        icon="lucide:trees"
        title="Lawn Maintenance"
        description="Professional lawn care services to keep your grass healthy, green, and perfectly manicured all year round."
        features={['Lawn Mowing', 'Hedging & Edging', 'Pruning & Mulching', 'Yard Cleanup']}
        ctaText="Get a Quote"
        ctaLink="/contact"
        reverse={true}
      />
    </div>

    <div class="services__garden-care" id="garden-care">
      <ImageCard
        image="/gardens.webp"
        imageAlt="Beautiful garden care and landscaping"
        icon="lucide:flower-2"
        title="Garden Care"
        description="Expert garden maintenance to keep your outdoor spaces beautiful and thriving through every season."
        features={['Hedge Trimming', 'Mulching', 'Garden Bed Care', 'Seasonal Cleanup']}
        ctaText="Get a Quote"
        ctaLink="/contact"
        reverse={false}
      />
    </div>
  </div>
</section>

<style>
  .services {
    background-color: var(--color-gray-50);
  }

  .services__header {
    text-align: center;
    max-width: 700px;
    margin-inline: auto;
    margin-bottom: var(--spacing-3xl);
  }

  .services__label {
    display: inline-block;
    padding: var(--spacing-xs) var(--spacing-md);
    background-color: var(--color-primary-100);
    color: var(--color-primary);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    border-radius: var(--radius-full);
    margin-bottom: var(--spacing-md);
  }

  .services__title {
    margin-bottom: var(--spacing-md);
  }

  .services__subtitle {
    font-size: var(--font-size-lg);
    color: var(--color-gray-600);
  }

  .services__pest-control {
    margin-bottom: var(--spacing-3xl);
  }

  .services__lawn-care {
    margin-bottom: var(--spacing-3xl);
  }

  .services__garden-care {
    margin-bottom: 0;
  }
</style>
