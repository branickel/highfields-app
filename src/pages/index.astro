---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import Features from '../components/Features.astro';
import Testimonials from '../components/Testimonials.astro';
import CTA from '../components/CTA.astro';
---

<Layout 
  title="Home"
  description="Opening mid November in Mackay. Expert pest control and lawn care — licensed, insured local team. Register interest for a free quote."
>
  <Hero 
    title="Coming Soon to Mackay"
    slogan="Opening Mid November"
    subtitle="Highfields Pest & Lawn Maintenance is opening mid November — expert, locally owned pest control and lawn care for Mackay and surrounding areas. Register your interest now for a free quote."
  />
  
  <Services />
  
  <Features />
  
  <Testimonials />
  
  <CTA 
    title="Opening Mid November in Mackay"
    subtitle="Be first in line — register your interest today and we’ll be ready when you need pest control or lawn care."
    buttonText="Register Interest"
  />
</Layout>
